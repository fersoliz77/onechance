rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function systemRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole
        : null;
    }

    function isAdmin() {
      return systemRole() == 'admin' || systemRole() == 'super_admin';
    }

    function canReadPublicOrPrivileged(uid) {
      return resource.data.status == 'published' || isOwner(uid) || isAdmin();
    }

    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
      allow update, delete: if isOwner(uid) || isAdmin();
    }

    match /players/{uid} {
      allow read: if canReadPublicOrPrivileged(uid);
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /coaches/{uid} {
      allow read: if canReadPublicOrPrivileged(uid);
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /clubs/{uid} {
      allow read: if canReadPublicOrPrivileged(uid);
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /agents/{uid} {
      allow read: if canReadPublicOrPrivileged(uid);
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /admin_audit_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /admin_audit_meta/{id} {
      allow read, write: if isAdmin();
    }
  }
}
