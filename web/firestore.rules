rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function systemRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole
        : null;
    }

    function isAdmin() {
      return isSignedIn() && (systemRole() == 'admin' || systemRole() == 'super_admin');
    }

    function isSuperAdmin() {
      return isSignedIn() && systemRole() == 'super_admin';
    }

    // Public profile collections — owners cannot self-promote status or featured flag
    match /players/{uid} {
      allow read:   if resource.data.status == 'published' || isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
                       && request.resource.data.status    == resource.data.status
                       && request.resource.data.isFeatured == resource.data.isFeatured
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /coaches/{uid} {
      allow read:   if resource.data.status == 'published' || isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
                       && request.resource.data.status == resource.data.status
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /clubs/{uid} {
      allow read:   if resource.data.status == 'published' || isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
                       && request.resource.data.status == resource.data.status
                    || isAdmin();
      allow delete: if isAdmin();
    }

    match /agents/{uid} {
      allow read:   if resource.data.status == 'published' || isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
                       && request.resource.data.status == resource.data.status
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Users — owners cannot self-elevate systemRole, permissions, or isActive
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                       && request.resource.data.systemRole == 'user'
                    || isSuperAdmin();
      allow update: if isOwner(uid)
                       && request.resource.data.systemRole   == resource.data.systemRole
                       && request.resource.data.permissions  == resource.data.permissions
                       && request.resource.data.isActive     == resource.data.isActive
                    || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Audit logs — Admin SDK writes only (client writes blocked)
    match /admin_audit_logs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /admin_audit_meta/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Conversations — all mutations via Admin SDK API routes
    match /conversations/{convId} {
      allow write: if false;
      allow read:  if isAdmin();
    }
  }
}
